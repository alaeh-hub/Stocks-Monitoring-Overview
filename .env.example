APP_NAME="Stocks Dashboard"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=

LOG_CHANNEL=stderr
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Laravel's own MySQL (the bundled "dashboard-db" container)
DB_CONNECTION=mysql
DB_HOST=dashboard-db
DB_PORT=3306
DB_DATABASE=dashboard
DB_USERNAME=dashboard
DB_PASSWORD=dashboard_secret
DB_ROOT_PASSWORD=root_secret

# The Stocks Monitoring MySQL that this dashboard READS.
# host.docker.internal = the MySQL port your stocks stack publishes on this PC.
# Using the shared Docker network instead? See README, step 3 (option B).
STOCKS_DB_HOST=host.docker.internal
STOCKS_DB_PORT=3306
STOCKS_DB_DATABASE=stocks
STOCKS_DB_USERNAME=stocks_readonly
STOCKS_DB_PASSWORD=change-me
