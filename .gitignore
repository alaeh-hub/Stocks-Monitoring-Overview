# Dependencies
/vendor
/node_modules

# Build output / Vite dev server marker
/public/build
/public/hot

# Secrets and local config
.env
.env.*
!.env.example

# Laravel runtime files (keep the folders via their .gitignore placeholders)
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/*.key
/bootstrap/cache/*
!/storage/logs/.gitignore
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/bootstrap/cache/.gitignore

# Tooling and OS
.phpunit.result.cache
.phpunit.cache
.php-cs-fixer.cache
npm-debug.log*
.idea/
.vscode/
.claude/
.DS_Store
Thumbs.db
*.log
